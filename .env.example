# ============================================================
# SkillSwap — Environment Variables Example
# ============================================================

# --- SERVER CONFIGURATION (server/.env) ---
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillswap?retryWrites=true&w=majority

# JWT secret for signing tokens
JWT_SECRET=your_jwt_secret_key_here

# Server port & environment
PORT=5000
NODE_ENV=development

# Allowed frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# --- CLIENT CONFIGURATION (client/.env) ---
# Backend API URL (for production deployments like Vercel / Render)
# VITE_API_URL=https://your-backend-api.onrender.com
# VITE_SOCKET_URL=https://your-backend-api.onrender.com
